{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "skipLibCheck": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": false,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true,
        "rootDir": "./src",
        "outDir": "dist-electron",
        "esModuleInterop": true,
        "types": ["node"]
    },
    "include": [
        "src/electronMain.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
