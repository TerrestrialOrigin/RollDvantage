{
  "name": "rolldvantage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist-electron/electronMain.js",
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "npm run clean && vite --strictPort",
    "build-web": "tsc -b && vite build",
    "build-android": "tsc -b && vite build &&npx cap sync android && npx cap open android",
    "build-ios": "tsc -b && vite build &&npx cap sync ios && npx cap open ios",
    "build-electron-app": "tsc -b && BUILD_TARGET=electron vite build && tsc -b tsconfig.electron.json",
    "build-electron-linux": "npm run build-electron-app && npx electron-builder --linux",
    "electron": "electron . --enable-logging",
    "dev-electron": "npm run build-electron-app && electron .",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "validate": "bash scripts/validate-all.sh",
    "clean": "rm -rf dist && rm -rf dist-electron",
    "print-check": "node scripts/print-check.mjs"
  },
  "build": {
    "appId": "com.terrestrialorigin.rolldvantage",
    "productName": "RollDvantage",
    "files": [
      "dist-electron/**/*",
      "!dist-electron/**/*.map"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist-electron"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "@capacitor/core": "^8.3.1",
    "auto-stuff-generator": "^0.4.0",
    "cross-platform-util": "^0.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-platform-util-types": "^0.3.3",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.21.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.22.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
